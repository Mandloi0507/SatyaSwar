# SatyaSwar ML Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env or any credentials to source control.

# Execution mode: 'auto', 'cuda', or 'cpu'
ML_DEVICE=auto

# Mock mode: set to 1 for deterministic scripted mock output without GPU or model downloads
ML_MOCK=0

# Environment: 'dev' or 'demo' ('demo' enforces privacy rules and disables debug dumps)
ML_ENV=dev

# Logging level: DEBUG, INFO, WARNING, ERROR
ML_LOG_LEVEL=INFO

# Standalone service host and port
ML_HOST=127.0.0.1
ML_PORT=8100

# Shared secret for ML standalone service (optional when run on localhost)
ML_API_SECRET=

# Development endpoints flag (enables /ml/analyze-window multipart upload)
ML_ENABLE_DEV_ENDPOINTS=0

# Privacy protection flags (MUST remain false in production/demo)
ML_DEBUG_DUMP_AUDIO=false
ML_LOG_TRANSCRIPTS=false

# Path to configuration file
ML_CONFIG_PATH=configs/default.yaml

# Hugging Face token (optional, only needed for gated models/checkpoints)
HF_TOKEN=
