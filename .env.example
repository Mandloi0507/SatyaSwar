# ==============================================================================
# SatyaSwar Backend - Environment Configuration Example
# Copy this file to '.env' and update the values for your local environment:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
#
# IMPORTANT:
#   - Never commit '.env' or real credentials into version control.
#   - Keep '.env' listed in '.gitignore'.
# ==============================================================================

# Application Runtime Environment (development | staging | production)
APP_ENV=development

# Firebase Admin SDK Configuration
# Note: For production / Cloud Run, Application Default Credentials (ADC) may be used
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json

# CORS Allowed Origins
# Supports comma-separated strings or JSON-encoded arrays
CORS_ORIGINS=http://localhost:3000

# Member 3: ML Audio Analysis Service Integration
ML_SERVICE_URL=http://localhost:9000
ML_TIMEOUT_SECONDS=3.0

# Audio Processing Settings (Provisional - Subject to Member 1 & Member 3 confirmation)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_WINDOW_SECONDS=3.5
AUDIO_HOP_SECONDS=1.75
AUDIO_SAMPLE_WIDTH_BYTES=2

# Risk Aggregation Engine (Provisional - Configurable thresholds)
RISK_ALPHA=0.4
RISK_HIGH_THRESHOLD=0.7
RISK_LOW_THRESHOLD=0.3
MIN_EVIDENCE_QUALITY=0.5

# Trusted-Contact Verification Settings
VERIFICATION_TTL_SECONDS=120
VERIFICATION_MAX_ATTEMPTS=3
# Optional HMAC secret placeholder (used only if verification-code design is approved)
VERIFICATION_HMAC_SECRET=change-this-to-a-secure-random-secret

